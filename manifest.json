{
  "schemaVersion": 1,
  "id": "com.sovchat.omarchy",
  "name": "SovChat",
  "version": "0.1.4",
  "author": "SovChat",
  "license": "MIT",
  "description": "Voice rooms, text chat, and screen and application sharing for Omarchy, with a native bar widget to install, launch, focus, and update the dedicated SovChat client.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "SovChat",
    "description": "Install, launch, and monitor SovChat voice, chat, and screen sharing from the Omarchy bar.",
    "category": "Communication",
    "aliases": [
      "sovchat",
      "voice",
      "chat",
      "screen-share"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "executable": "",
      "pollIntervalSec": 5
    },
    "schema": [
      {
        "key": "executable",
        "type": "string",
        "label": "Client executable",
        "defaultValue": ""
      },
      {
        "key": "pollIntervalSec",
        "type": "integer",
        "label": "Status interval (seconds)",
        "min": 2,
        "max": 60,
        "step": 1,
        "defaultValue": 5
      }
    ]
  }
}
