{
  "schemaVersion": 1,
  "id": "com.sovchat.omarchy",
  "name": "SovChat",
  "version": "0.1.3",
  "author": "SovChat",
  "license": "MIT",
  "description": "An Omarchy-native launcher and status panel for the SovChat desktop client.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "SovChat",
    "description": "See local client status, launch or focus SovChat, and open the web app.",
    "category": "Communication",
    "aliases": [
      "sovchat",
      "voice",
      "chat"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "executable": "",
      "pollIntervalSec": 5
    },
    "schema": [
      {
        "key": "executable",
        "type": "string",
        "label": "Client executable",
        "defaultValue": ""
      },
      {
        "key": "pollIntervalSec",
        "type": "integer",
        "label": "Status interval (seconds)",
        "min": 2,
        "max": 60,
        "step": 1,
        "defaultValue": 5
      }
    ]
  }
}
